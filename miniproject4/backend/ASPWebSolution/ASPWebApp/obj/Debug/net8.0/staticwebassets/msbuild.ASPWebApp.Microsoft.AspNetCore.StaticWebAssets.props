      <SourceId>ASPWebApp</SourceId>
      <ContentRoot>$(MSBuildThisFileDirectory)..\staticwebassets\</ContentRoot>
      <BasePath>_content/ASPWebApp</BasePath>
      <RelativePath>index.html</RelativePath>
      <AssetKind>All</AssetKind>
